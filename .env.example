# Okta Authentication Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# Okta Domain (without https://)
# Example: dev-12345678.okta.com
OKTA_DOMAIN=your-okta-domain.okta.com

# Okta Username (email)
OKTA_USERNAME=your-username@example.com

# Okta Password
OKTA_PASSWORD=your-secure-password

# Okta OAuth Client ID (optional, for API authentication)
OKTA_CLIENT_ID=your-client-id

# Okta OAuth Client Secret (optional, for API authentication)
OKTA_CLIENT_SECRET=your-client-secret

# Application Base URL (optional)
BASE_URL=http://localhost:3000

# Token Encryption Key (32-byte hex string, optional but recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# CI/CD Environment Flag
CI=false
